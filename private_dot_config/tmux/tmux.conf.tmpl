# ~/.config/tmux/tmux.conf
#
# MANAGED BY CHEZMOI -- edits here are overwritten by `chezmoi apply`.
# Source: private_dot_config/tmux/tmux.conf.tmpl
#
# Machine-local settings do not belong in this file. Two escape hatches:
#   1. A single value that differs per machine -> add a key under [data] in
#      ~/.config/chezmoi/chezmoi.toml and guard it with `hasKey` (see below).
#   2. Freeform local commands -> ~/.config/tmux/local.conf, sourced last.
#
# tmux reads config once, when the server creates its first session. After
# changing this file: `tmux source-file ~/.config/tmux/tmux.conf`, or restart
# the server entirely if you changed something servers cache (default-shell).

{{- if hasKey . "override_shell" }}

# This workstation authenticates against a university account, so the passwd
# shell cannot be changed locally. Point tmux at the shell we actually want.
# default-command is left empty, which makes tmux start this as a LOGIN shell
# (-> .zprofile, then .zshrc). Value: [data].override_shell in the local,
# unsynced ~/.config/chezmoi/chezmoi.toml. Absent on a machine -> line is not
# emitted and tmux falls back to the passwd shell.
set-option -g default-shell {{ .override_shell }}
{{- end }}



# ==========================================================================
# Terminal capabilities
# ==========================================================================
# tmux-256color carries the right terminfo; RGB advertises 24-bit colour so
# the hex values below render exactly rather than being quantised to 256.
set  -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-kitty:RGB"

# Pass terminal focus in/out events (CSI I / CSI O) through to programs in
# panes. Off by default, which silently breaks anything relying on them.
#
# The consumer here is nvim: LazyVim binds FocusGained to :checktime (see
# lazyvim/config/autocmds.lua), which is what reloads a buffer after the file
# changed on disk. Inside tmux without this, that autocmd simply never fires.
#
# Not machine-specific, so it belongs in the synced config rather than behind
# a data key: it asks for a behaviour, and tmux only requests focus reporting
# from terminals that support it, so it is inert elsewhere rather than wrong.
#
# Changing this needs attached clients to detach and reattach to take effect.
set -g focus-events on


# ==========================================================================
# Window & pane numbering
# ==========================================================================
set  -g base-index 1          # windows count from 1 -- matches the keyboard
setw -g pane-base-index 1     # keep panes consistent with windows
set  -g renumber-windows on   # close a middle window and the rest close ranks,
                              # so numbering never grows holes


# ==========================================================================
# Mouse
# ==========================================================================
# Clicking a window in the status bar to switch to it needs no plugin and no
# custom binding: tmux has bound MouseDown1Status to `select-window -t =` for
# years. The only thing missing is that `mouse` itself defaults to off.
#
# Turning it on also activates the other built-in bindings, all default:
#   left click on a tab      select that window
#   right click on a tab     window menu (swap / rename / kill / new)
#   right click on the left  session menu (next / prev / rename / new)
#   wheel over the bar       previous / next window
#   click a pane             select it
#   drag a pane border       resize
#   double / triple click    select word / line and copy
#
# The trade-off: tmux now grabs the mouse, so dragging inside a pane enters
# copy-mode and copies to a tmux buffer instead of making a terminal-level
# selection. In kitty, hold Shift to bypass the grab and get kitty's own
# selection back (its default mouse_map binds shift+left to mouse_selection
# for grabbed programs, and shift+middle to paste primary).
set -g mouse on


# ==========================================================================
# Status bar
# ==========================================================================
# tokyonight (storm) palette -- same colours as the nvim colourscheme, so the
# bar sits under an nvim pane without clashing. Retheme by editing only here.
set -g @bg      "#1f2335"
set -g @bg_hl   "#292e42"
set -g @fg      "#c0caf5"
set -g @dim     "#565f89"
set -g @blue    "#7aa2f7"
set -g @cyan    "#7dcfff"
set -g @purple  "#bb9af7"
set -g @orange  "#ff9e64"
set -g @red     "#f7768e"

# Activity flags are OFF by default -- without this the flag never sets and
# any activity styling is dead code. visual-activity stays off so activity
# shows only in the bar, rather than interrupting with a status message.
setw -g monitor-activity on
set  -g visual-activity  off

set -g status on
set -g status-position bottom
set -g status-justify left
set -g status-interval 5
set -g status-left-length 40
set -g status-right-length 60

# Style options take literal colours: format expansion is not guaranteed here,
# unlike the status-* strings below where #{@var} is reliable.
set -g status-style              "bg=#1f2335,fg=#a9b1d6"
set -g message-style             "bg=#292e42,fg=#c0caf5"

# Separators. The powerline glyphs live in the Unicode Private Use Area and
# only exist in patched fonts, so they are gated on the same data key that
# sets kitty's font. Without that key they fall back to empty strings and the
# bar renders as plain colour blocks -- correct, just less fancy.
#
# Measured in this tmux: U+E0B0 and U+E0B2 are width 1, which is what patched
# fonts draw, so the bar stays aligned. That agreement is the whole reason
# these are safe where arbitrary emoji are not.
{{- if hasKey . "powerline_font" }}
set -g @sep_r ""
set -g @sep_l ""
{{- else }}
set -g @sep_r ""
set -g @sep_l ""
{{- end }}

# Session name on the left. It turns orange while the prefix key is pending,
# so you can see tmux waiting for the second key of a chord -- worth having
# over SSH, where a dropped prefix otherwise shows up as the *next* key doing
# something baffling.
#
# NB: #[fg=x,bg=y] must not appear inside #{?...}: the comma would split the
# conditional's branches. Hence the separate single-attribute styles.
set -g status-left "#{?client_prefix,#[bg=#{@orange}],#[bg=#{@blue}]}#[fg=#{@bg}]#[bold] #S #[none]#{?client_prefix,#[fg=#{@orange}],#[fg=#{@blue}]}#[bg=#{@bg}]#{@sep_r} "

set -g window-status-separator ""

# Inactive window. Activity brightens the label from dim to normal fg and adds
# an orange *; a bell adds a bell emoji. Done inline rather than via
# window-status-activity-style, because the #[fg=] opening this format would
# override that option anyway.
#
# Markers are chosen for width agreement. * is width 1. U+1F514 is East Asian
# Wide, which tmux and the terminal both count as 2. Glyphs needing a
# variation selector (U+FE0F) are deliberately avoided: tmux ignores VS16 and
# counts them 1 while the terminal draws 2, which shifts the whole bar.
set -g window-status-format "#{?window_activity_flag,#[fg=#{@fg}],#[fg=#{@dim}]} #I #W#{?window_zoomed_flag, +,}#{?window_activity_flag, #[fg=#{@orange}]*,}#{?window_bell_flag, 🔔,} "

# Current window: a filled block, wrapped in separators where available.
set -g window-status-current-format "#[fg=#{@purple}]#[bg=#{@bg}]#{@sep_l}#[fg=#{@bg}]#[bg=#{@purple}]#[bold] #I #W#{?window_zoomed_flag, +,}#[none]#[fg=#{@purple}]#[bg=#{@bg}]#{@sep_r}"

# Host on the right -- worth showing when you are on a remote workstation.
set -g status-right "#[fg=#{@bg_hl}]#[bg=#{@bg}]#{@sep_l}#[fg=#{@dim}]#[bg=#{@bg_hl}] #h #[fg=#{@cyan}]%H:%M "


# --------------------------------------------------------------------------
# Machine-local overrides.
#
# Keep this LAST: tmux applies config top to bottom, so anything sourced here
# wins over the settings above. -q means no error when the file is absent, so
# machines without a local.conf are fine.
# --------------------------------------------------------------------------
source-file -q ~/.config/tmux/local.conf
